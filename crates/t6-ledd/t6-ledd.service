[Unit]
Description=T6 indicator daemon (LEDs, night mode, beeper)
After=systemd-modules-load.service
# We restore the LCD backlight once per boot; run after systemd-backlight has
# done its (possibly stale) restore so ours is the final value.
After=systemd-backlight@backlight:t6_ec_backlight.service
ConditionPathExists=/etc/t6-ledd.toml

[Service]
Type=simple
ExecStart=/usr/sbin/t6-ledd --config /etc/t6-ledd.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RuntimeDirectory=t6-ledd t6-display
# Keep boot markers and the shared display lock inode across service restarts.
# Both directories are cleared on reboot because /run is tmpfs.
RuntimeDirectoryPreserve=yes
# LEDs and the beeper live under /sys; the config is rewritten in place.
ReadWritePaths=/sys/class/leds /sys/devices /etc/t6-ledd.toml

[Install]
WantedBy=multi-user.target
