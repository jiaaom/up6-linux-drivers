# Shared definitions for the t6control lifecycle scripts (sourced, not executed).

# The web backend runs as a systemd unit, like the first-party fnOS apps:
# App Center records app state but does not start apps at boot.
WEBD_UNIT=t6-webd
WEBD_UNIT_FILE=/etc/systemd/system/$WEBD_UNIT.service

# The daemons are system services (they must run from early boot, whether
# or not this app is started), laid out exactly like a plain-Debian install.
DAEMONS=(t6-fand t6-ledd)

fail() {
    echo "$*" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    exit 1
}

# Install (or update) the daemons as system services. An existing
# configuration file is kept; the packaged default is used only on first
# install.
install_daemons() {
    local d
    [ -d /sys/module/t6_platform ] || fail "The T6 Drivers package is not loaded (t6_platform module missing)."
    for d in "${DAEMONS[@]}"; do
        install -m 755 "$TRIM_APPDEST/bin/$d" "/usr/sbin/$d"
        [ -f "/etc/$d.toml" ] || install -m 644 "$TRIM_APPDEST/$d.toml" "/etc/$d.toml"
        install -m 644 "$TRIM_APPDEST/$d.service" "/etc/systemd/system/$d.service"
    done
    systemctl daemon-reload
    for d in "${DAEMONS[@]}"; do
        systemctl enable "$d" >/dev/null 2>&1
        systemctl restart "$d" || fail "$d failed to start (journalctl -u $d)."
    done
}

# Remove the services and binaries. The configuration files hold user
# tuning, so they stay unless the uninstall wizard asked to remove them
# (a same-version reinstall from the CLI also passes through here).
remove_daemons() {
    local d
    for d in "${DAEMONS[@]}"; do
        systemctl disable --now "$d" >/dev/null 2>&1 || true
        rm -f "/etc/systemd/system/$d.service" "/usr/sbin/$d"
        case "${wizard_remove_settings:-false}" in
            true|1|yes|on) rm -f "/etc/$d.toml" ;;
        esac
    done
    case "${wizard_remove_settings:-false}" in
        true|1|yes|on) rm -f /etc/t6-display.conf ;;
    esac
    systemctl daemon-reload
}

# Generate the unit from the package paths and enable it.
install_webd() {
    cat > "$WEBD_UNIT_FILE" <<EOF
[Unit]
Description=T6 Control Center web backend
After=t6-fand.service t6-ledd.service
# The gateway forwards /app/t6control to the socket; start once nginx is up.
After=trim_nginx.service

[Service]
Type=simple
Environment=TRIM_APPVER=$TRIM_APPVER
ExecStart=$TRIM_APPDEST/bin/t6-webd --socket $TRIM_APPDEST/app.sock --prefix /app/t6control
Restart=on-failure
RestartSec=5
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable "$WEBD_UNIT" >/dev/null 2>&1
}

remove_webd() {
    systemctl disable --now "$WEBD_UNIT" >/dev/null 2>&1 || true
    rm -f "$WEBD_UNIT_FILE" "$TRIM_APPDEST/app.sock"
    systemctl daemon-reload
}

start_webd() {
    [ -f "$WEBD_UNIT_FILE" ] || install_webd
    systemctl restart "$WEBD_UNIT" || fail "t6-webd failed to start (journalctl -u t6-webd)."
}

stop_webd() {
    systemctl stop "$WEBD_UNIT" 2>/dev/null || true
}

webd_running() {
    systemctl is-active --quiet "$WEBD_UNIT"
}
