#!/bin/bash
# Runtime control of the web backend (a systemd unit; see cmd/common).
# The fan and LED daemons are separate services and keep running whether
# or not the app is started.
. "$(dirname "$0")/common"

case "$1" in
    start) start_webd ;;
    stop) stop_webd ;;
    status) webd_running && exit 0 || exit 3 ;;
    *) exit 1 ;;
esac
