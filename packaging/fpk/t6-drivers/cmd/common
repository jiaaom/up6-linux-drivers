# Shared helpers for the t6-drivers lifecycle scripts (sourced, not executed).

# dkms, modprobe etc. live in sbin; don't rely on App Center's PATH having it.
export PATH="/usr/local/sbin:/usr/sbin:/sbin:$PATH"

# Report a user-facing error (shown by App Center) and exit.
fail() {
    echo "$*" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    exit 1
}

# Install system packages the way App Center runs us: as root, without a
# terminal. Waits for another apt/dpkg run instead of failing on its lock,
# and refreshes the package lists once if the first attempt fails (stale
# lists are the usual cause). apt's output goes to `journalctl -t t6-drivers-apt`.
APT_TAG=t6-drivers-apt
apt_try_install() {
    local opts=(-y -q --no-install-recommends -o DPkg::Lock::Timeout=120)
    export DEBIAN_FRONTEND=noninteractive
    logger -t "$APT_TAG" "apt-get install $*"
    apt-get "${opts[@]}" install "$@" 2>&1 | logger -t "$APT_TAG"
    [ "${PIPESTATUS[0]}" -eq 0 ] && return 0
    apt-get -q -o DPkg::Lock::Timeout=120 update 2>&1 | logger -t "$APT_TAG"
    apt-get "${opts[@]}" install "$@" 2>&1 | logger -t "$APT_TAG"
    return "${PIPESTATUS[0]}"
}

# Build prerequisites. dkms is an ordinary Debian package: install it if
# missing, and only ask the user when that fails. The kernel headers ship with
# FygoOS itself; if they are gone that is a system problem we can't repair, so
# just say so.
check_build_prereqs() {
    if ! command -v dkms >/dev/null; then
        logger -t t6-drivers "dkms missing; installing"
        apt_try_install dkms
        command -v dkms >/dev/null || fail "DKMS is needed to build the drivers, and installing it automatically failed (details: journalctl -t $APT_TAG).
Run as root over SSH, then install again:
apt install dkms"
    fi
    [ -d "/lib/modules/$(uname -r)/build" ] || fail "The kernel headers for $(uname -r) are missing.
They are part of FygoOS itself, so this is a system problem T6 Drivers cannot fix. Update or repair FygoOS, then install again."
}

# Run install-dkms.sh from the installed package directory, forwarding its
# last lines to the App Center log on failure.
run_installer() {
    local out
    if ! out=$("$TRIM_APPDEST/install-dkms.sh" "$@" 2>&1); then
        fail "T6 drivers: install-dkms.sh $* failed: $(printf '%s\n' "$out" | tail -n 5)"
    fi
}

# Two units run install-dkms.sh --repair (see its header):
#  - t6-drivers-check runs at every boot, before the T6 services, and builds
#    the modules when a kernel update left the new kernel without them.
#  - t6-drivers-repair is started on demand by the T6 Control Center. It has
#    no ordering against the services because it restarts them itself.
# Both take the script's lock, so they never overlap each other or an
# App Center install/upgrade.
CHECK_UNIT=t6-drivers-check
REPAIR_UNIT=t6-drivers-repair
T6_SERVICES="t6-fand.service t6-ledd.service t6-paneld.service t6-panel-kiosk.service t6-webd.service"

install_units() {
    cat > "/etc/systemd/system/$CHECK_UNIT.service" <<UNIT
[Unit]
Description=T6 drivers: build missing DKMS modules for the running kernel
After=local-fs.target systemd-modules-load.service
Before=$T6_SERVICES

[Service]
Type=oneshot
ExecStart=$TRIM_APPDEST/install-dkms.sh --repair --boot
# Until the driver loads, fans retain the EC's fixed power-on duty.
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
UNIT
    cat > "/etc/systemd/system/$REPAIR_UNIT.service" <<UNIT
[Unit]
Description=T6 drivers: rebuild and reload DKMS modules, restart T6 services

[Service]
Type=oneshot
ExecStart=$TRIM_APPDEST/install-dkms.sh --repair
TimeoutStartSec=10min
UNIT
    systemctl daemon-reload
    systemctl enable "$CHECK_UNIT" >/dev/null 2>&1
}

remove_units() {
    systemctl disable "$CHECK_UNIT" >/dev/null 2>&1 || true
    rm -f "/etc/systemd/system/$CHECK_UNIT.service" "/etc/systemd/system/$REPAIR_UNIT.service"
    systemctl daemon-reload
}
