# Shared definitions for the t6-panel lifecycle scripts (sourced, not executed).
#
# The panel backend runs as a systemd unit. It serves two surfaces from one
# process: the FygoOS gateway socket (authenticated, /app/t6-panel) and a local
# no-login TCP shell for the on-device Chromium kiosk. The fan/LED daemons it
# reads belong to T6 Control Center (a hard dependency), so we do not touch them.

PANELD_UNIT=t6-paneld
PANELD_UNIT_FILE=/etc/systemd/system/$PANELD_UNIT.service
# Local no-login shell the on-device kiosk loads (http://127.0.0.1:9600/).
PANEL_LOCAL_ADDR=127.0.0.1:9600

fail() {
    echo "$*" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    exit 1
}

# ---- appliance-compositor (display + sound) ----------------------------------
#
# weston, the Mesa GL stack and PipeWire belong to appliance-compositor, a
# separate package the panel depends on (it also serves other screen apps,
# e.g. a TV app on the rear HDMI port). We use only its runtime contract
# (docs/CONTRACT.md in that project): the paths, unit names and config
# directories below — none of its files.
COMPOSITOR_LINK=/usr/local/lib/appliance-compositor
COMPOSITOR_CONTRACT=1
COMPOSITOR_UNIT=appliance-compositor
COMPOSITOR_ETC=/etc/appliance-compositor
CLIENT_NAME=t6-panel
# Touches must stay on the built-in screen when a TV is attached too: weston
# maps an input device to the output named in its udev WL_OUTPUT property.
TOUCH_RULE=/etc/udev/rules.d/90-t6-panel-touch.rules

check_compositor() {
    local ver
    ver=$(cat "$COMPOSITOR_LINK/CONTRACT" 2>/dev/null) || ver=""
    [ -n "$ver" ] || fail "Install Appliance Compositor first (it provides the display and sound server)."
    [ "$ver" = "$COMPOSITOR_CONTRACT" ] || fail "This version of T6 Front Panel needs Appliance Compositor with contract version $COMPOSITOR_CONTRACT; the installed one has $ver.
Install the matching Appliance Compositor from the same release."
}

compositor_running() { systemctl is-active --quiet "$COMPOSITOR_UNIT"; }

# Register with the compositor: our window rules and output settings, the
# pre-start hook for the built-in screen's colour range, and the touch mapping.
# A running compositor reads them on restart (which restarts the kiosk too),
# so restart it only when our fragment actually changed: other apps' windows
# (e.g. a TV) go down with it.
install_compositor_client() {
    local frag=$COMPOSITOR_ETC/clients.d/$CLIENT_NAME.ini changed=0
    mkdir -p "$COMPOSITOR_ETC/clients.d" "$COMPOSITOR_ETC/pre-start.d"
    if ! cmp -s "$TRIM_APPDEST/app/compositor.ini" "$frag"; then
        install -m 644 "$TRIM_APPDEST/app/compositor.ini" "$frag"
        changed=1
    fi
    ln -sfn "$TRIM_APPDEST/app/compositor-pre-start" "$COMPOSITOR_ETC/pre-start.d/$CLIENT_NAME"
    cat > "$TOUCH_RULE" <<'RULE'
# T6 Front Panel: the touchscreen and pen belong to the built-in screen
# (weston maps an input device to the output named in WL_OUTPUT).
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="FT8722 *", ENV{WL_OUTPUT}="HDMI-A-1"
RULE
    udevadm control --reload 2>/dev/null || true
    udevadm trigger --subsystem-match=input --action=change 2>/dev/null || true
    if [ "$changed" = 1 ] && compositor_running; then
        systemctl restart --no-block "$COMPOSITOR_UNIT"
    fi
    return 0
}

remove_compositor_client() {
    rm -f "$COMPOSITOR_ETC/clients.d/$CLIENT_NAME.ini" "$COMPOSITOR_ETC/pre-start.d/$CLIENT_NAME" "$TOUCH_RULE"
    udevadm control --reload 2>/dev/null || true
    # Let a running compositor drop our rules and output settings.
    compositor_running && systemctl restart --no-block "$COMPOSITOR_UNIT"
    return 0
}

# Up to 1.4 the panel ran its own weston (in the kiosk unit) and PipeWire
# (t6-audio*). appliance-compositor takes the audio units (and our old
# root-linger marker) over when it is installed; remove whatever is left.
remove_legacy() {
    local u
    for u in t6-audio-pulse t6-audio-session t6-audio; do
        [ -f "/etc/systemd/system/$u.service" ] || continue
        systemctl disable --now "$u" >/dev/null 2>&1 || true
        rm -f "/etc/systemd/system/$u.service"
    done
    systemctl daemon-reload
}

# Generate the unit from the package paths and enable it. Runs as root: the
# panel writes the backlight and /var/lib/t6-paneld, and
# drives the LED daemon's control socket.
install_paneld() {
    cat > "$PANELD_UNIT_FILE" <<UNIT
[Unit]
Description=T6 front-panel backend
After=t6-fand.service t6-ledd.service
# The gateway forwards /app/t6-panel to the socket; start once nginx is up.
After=trim_nginx.service

[Service]
Type=simple
Environment=TRIM_APPVER=$TRIM_APPVER
ExecStart=$TRIM_APPDEST/bin/t6-paneld --gateway-socket $TRIM_APPDEST/app.sock --prefix /app/t6-panel --listen $PANEL_LOCAL_ADDR --www $TRIM_APPDEST/www --web $TRIM_APPDEST/web
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
UNIT
    systemctl daemon-reload
    systemctl enable "$PANELD_UNIT" >/dev/null 2>&1
}

remove_paneld() {
    systemctl disable --now "$PANELD_UNIT" >/dev/null 2>&1 || true
    systemctl reset-failed "$PANELD_UNIT" >/dev/null 2>&1 || true  # a stopped Electron/daemon can read as "failed"
    rm -f "$PANELD_UNIT_FILE" "$TRIM_APPDEST/app.sock"
    systemctl daemon-reload
}

# Uninstall wizard: "also remove settings" (dashboard, theme, colour
# correction, kiosk profile, remembered fnOS sign-in). Runs from
# uninstall_callback, where the App Center passes wizard values; the value is
# logged (`journalctl -t t6-panel`).
remove_settings() {
    logger -t t6-panel "uninstall: wizard_settings=${wizard_settings:-<unset>}"
    case "${wizard_settings:-keep}" in
        remove) rm -rf /var/lib/t6-paneld && logger -t t6-panel "uninstall: removed /var/lib/t6-paneld" ;;
    esac
}

start_paneld() {
    [ -f "$PANELD_UNIT_FILE" ] || install_paneld
    systemctl restart "$PANELD_UNIT" || fail "t6-paneld failed to start (journalctl -u t6-paneld)."
}

stop_paneld() {
    systemctl stop "$PANELD_UNIT" 2>/dev/null || true
}

paneld_running() {
    systemctl is-active --quiet "$PANELD_UNIT"
}

# ---- on-device kiosk (Electron) ----------------------------------------------
#
# The panel's Electron shell is a window of appliance-compositor on the
# built-in screen. It is a boot service, not a desktop: no display manager,
# no greeter (fnOS ships graphical.target with no DM; we just add one service
# under multi-user.target). The bundled Electron runtime lives under
# $TRIM_APPDEST/app.
KIOSK_UNIT=t6-panel-kiosk
KIOSK_UNIT_FILE=/etc/systemd/system/$KIOSK_UNIT.service

# The admin page can turn the front-panel app off (panel_enabled=false in
# t6-paneld's settings); App Center start/install/upgrade must not undo that.
panel_enabled() {
    # Off only when explicitly false; no file / bad JSON = default on.
    ! python3 -c 'import json,sys; sys.exit(0 if json.load(open("/var/lib/t6-paneld/settings.json")).get("panel_enabled", True) is False else 1)' 2>/dev/null
}

install_kiosk() {
    cat > "$KIOSK_UNIT_FILE" <<UNIT
[Unit]
Description=T6 front-panel kiosk (Electron on appliance-compositor)
# The renderer loads the backend's local shell ($PANEL_LOCAL_ADDR); the hidden
# login window needs the gateway/login SPA — both come up under these.
After=$PANELD_UNIT.service trim_nginx.service $COMPOSITOR_UNIT.service appliance-audio-pulse.service
Wants=$PANELD_UNIT.service appliance-audio-pulse.service
# A window of the compositor: needs it, and restarts with it.
Requires=$COMPOSITOR_UNIT.service
PartOf=$COMPOSITOR_UNIT.service

[Service]
Type=simple
# Electron runs --no-sandbox (root); the compositor's client environment
# (Wayland socket, root's runtime dir with PipeWire).
EnvironmentFile=$COMPOSITOR_LINK/client.env
Environment=NAS_HOST=127.0.0.1
Environment=PANEL_PORT=${PANEL_LOCAL_ADDR##*:}
# Chromium profile (UI prefs in localStorage). Without this — and with no
# \$HOME under systemd — Electron would use /tmp, which is wiped at boot.
Environment=PANEL_DATA_DIR=/var/lib/t6-paneld/kiosk
ExecStart=$TRIM_APPDEST/app/run-kiosk.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
UNIT
    systemctl daemon-reload
    if panel_enabled; then
        systemctl enable "$KIOSK_UNIT" >/dev/null 2>&1
    else
        systemctl disable "$KIOSK_UNIT" >/dev/null 2>&1
    fi
}

remove_kiosk() {
    systemctl disable --now "$KIOSK_UNIT" >/dev/null 2>&1 || true
    systemctl reset-failed "$KIOSK_UNIT" >/dev/null 2>&1 || true  # a stopped Electron/daemon can read as "failed"
    rm -f "$KIOSK_UNIT_FILE"
    systemctl daemon-reload
}

start_kiosk() {
    [ -f "$KIOSK_UNIT_FILE" ] || install_kiosk
    panel_enabled || return 0
    systemctl restart "$KIOSK_UNIT" || fail "t6-panel-kiosk failed to start (journalctl -u $KIOSK_UNIT)."
}

stop_kiosk() {
    systemctl stop "$KIOSK_UNIT" 2>/dev/null || true
}
