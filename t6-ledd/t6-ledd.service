[Unit]
Description=T6 indicator daemon (LEDs, night mode, beeper)
After=systemd-modules-load.service
ConditionPathExists=/etc/t6-ledd.toml

[Service]
Type=simple
ExecStart=/usr/sbin/t6-ledd --config /etc/t6-ledd.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RuntimeDirectory=t6-ledd
# Keep /run/t6-ledd across service restarts so the once-per-boot beep marker
# survives upgrades/reloads (it is still cleared on reboot; /run is tmpfs).
RuntimeDirectoryPreserve=yes
# LEDs and the beeper live under /sys; the config is rewritten in place.
ReadWritePaths=/sys/class/leds /sys/devices /etc/t6-ledd.toml

[Install]
WantedBy=multi-user.target
