#!/usr/bin/env python3
"""Send one command to a running weston-appliance-shell and print the reply.

    appliance-shell-ctl list
    appliance-shell-ctl raise mpv
    appliance-shell-ctl rotate '#3' 90

The socket defaults to $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY.appliance-shell;
override with -s PATH or $APPLIANCE_SHELL_SOCKET.
"""
import json
import os
import socket
import sys


def default_socket():
    path = os.environ.get("APPLIANCE_SHELL_SOCKET")
    if path:
        return path
    runtime = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    display = os.environ.get("WAYLAND_DISPLAY", "wayland")
    return os.path.join(runtime, display + ".appliance-shell")


def main(argv):
    path = default_socket()
    if len(argv) >= 2 and argv[0] == "-s":
        path, argv = argv[1], argv[2:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 2

    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(path)
        s.sendall((" ".join(argv) + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk

    reply = json.loads(buf)
    if argv[0] == "list" and reply.get("ok") and sys.stdout.isatty():
        print("%-4s %-24s %-5s %-4s %-6s %-5s %s" %
              ("id", "app_id", "layer", "rot", "hidden", "focus", "title"))
        for w in reply["windows"]:
            print("%-4s %-24s %-5s %-4s %-6s %-5s %s" % (
                ("%d" % w["id"]) + ("^%d" % w["parent"] if w["parent"] else ""),
                w["app_id"][:24], w["layer"], w["rotation"],
                "yes" if w["hidden"] else "", "*" if w["focused"] else "",
                w["title"]))
    else:
        print(json.dumps(reply))
    return 0 if reply.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
